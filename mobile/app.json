{
  "expo": {
    "name": "ConteoÁgil",
    "slug": "conteo-agil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conteoagil",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.checo27.conteoagil"
    },
    "android": {
      "package": "com.checo27.conteoagil",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1424"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070B14"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ConteoÁgil usa la cámara para escanear los códigos de barras de los artículos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "56f623f6-d532-4f65-9218-c7e76b4c5bcb"
      }
    },
    "owner": "checo27"
  }
}
